# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Stripe ===
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# === Stannp (postcard printing & posting) ===
# API key from the Stannp dashboard → Settings → API. One key drives BOTH live
# dispatch and the "Preview exact printed postcard" proof — preview runs in
# Stannp test mode, which renders the real print-ready PDF without printing,
# posting or charging.
STANNP_API_KEY=your_stannp_api_key
# Optional single-line return address printed on the back. Falls back to your
# Stannp account address when unset.
STANNP_RETURN_ADDRESS=

# === Resend ===
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.co.uk

# === Admin ===
ADMIN_PASSWORD=change-me-to-something-secure

# === Cron Security ===
CRON_SECRET=generate-a-random-32-char-string

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Land Registry ===
LAND_REGISTRY_CSV_URL=http://prod.publicdata.landregistry.gov.uk.s3-website-eu-west-1.amazonaws.com/pp-monthly-update.txt
